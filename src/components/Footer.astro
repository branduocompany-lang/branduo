---
import { SITE } from '@/lib/site';
import { withBase } from '@/lib/url';
---

<section class="cta" id="contact">
  <div class="container">
    <div class="cta__panel">
      <span class="cta__glow cta__glow--a" aria-hidden="true"></span>
      <span class="cta__glow cta__glow--b" aria-hidden="true"></span>

      <div class="cta__text">
        <p class="cta__eyebrow" data-reveal>contact</p>
        <h2 data-reveal data-delay="0.1">한 곳 한 곳 제대로,<br />대표가 직접 상담합니다.</h2>
        <p class="cta__sub" data-reveal data-delay="0.2">
          지금 상황을 먼저 듣고, 꼭 필요한 방향만 솔직하게 말씀드립니다.
        </p>
      </div>

      <ul class="cta__list" data-stagger="0.1">
        <li>
          <a href="tel:050713083454">
            <span class="cta__ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
                ><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A15 15 0 013 6a2 2 0 012-2z" /></svg
              >
            </span>
            <span class="cta__label"><small>전화 상담</small><strong>0507-1308-3454</strong></span>
            <svg class="cta__go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
              ><path d="M5 12h14M13 6l6 6-6 6" /></svg
            >
          </a>
        </li>
        <li>
          <a href="http://pf.kakao.com/_ZTLEX/chat" target="_blank" rel="noopener noreferrer">
            <span class="cta__ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
                ><path d="M4 5h16v11H10l-5 4v-4H4z" /></svg
              >
            </span>
            <span class="cta__label"><small>카카오톡</small><strong>채널로 문의하기</strong></span>
            <svg class="cta__go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
              ><path d="M5 12h14M13 6l6 6-6 6" /></svg
            >
          </a>
        </li>
        <li>
          <a href="mailto:brand_duo@naver.com">
            <span class="cta__ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
                ><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg
              >
            </span>
            <span class="cta__label"><small>이메일</small><strong>brand_duo@naver.com</strong></span>
            <svg class="cta__go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
              ><path d="M5 12h14M13 6l6 6-6 6" /></svg
            >
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <img class="footer__logo" src={withBase('/images/logo.png')} alt={SITE.name} width="739" height="720" />
    </div>

    <div class="footer__bottom">
      <address>
        <p><span>상호명 : 브랜듀오</span> <i>|</i> <span>대표자 : 안형원</span> <i>|</i> <span>사업자번호 : 582-56-00950</span></p>
        <p><span>E-MAIL : brand_duo@naver.com</span> <i>|</i> <span>주소 : 경기 남양주시 순화궁로 249 C동 232호</span></p>
      </address>
      <div class="footer__tel">
        <strong>0507-1308-3454</strong>
        <span>월요일-금요일 09:00~20:00</span>
      </div>
    </div>

    <p class="footer__copy">Copyright © {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .cta {
    padding-block: 4rem 4.5rem;
    background: #fff;
  }
  .cta__panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding: clamp(2rem, 5vw, 4.5rem);
    border-radius: 36px;
    background:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px) 0 0 / 100% 44px,
      linear-gradient(135deg, #0b1440, #0a1a63 55%, #10236f);
    color: #fff;
    overflow: hidden;
  }
  .cta__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    pointer-events: none;
  }
  .cta__glow--a {
    top: -120px;
    left: -60px;
    width: 340px;
    height: 340px;
    background: rgba(30, 91, 255, 0.55);
  }
  .cta__glow--b {
    right: -80px;
    bottom: -140px;
    width: 380px;
    height: 380px;
    background: rgba(122, 77, 255, 0.4);
  }
  .cta__text,
  .cta__list {
    position: relative;
  }
  .cta__eyebrow {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.3rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #b9ccff;
  }
  .cta h2 {
    font-size: clamp(1.7rem, 1.2rem + 1.9vw, 2.7rem);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .cta__sub {
    margin-top: 1.25rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.7;
  }
  .cta__list {
    display: grid;
    gap: 0.9rem;
    padding: 0;
    list-style: none;
  }
  .cta__list a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    transition:
      transform 0.4s var(--ease-out),
      background-color 0.3s,
      border-color 0.3s;
  }
  .cta__list a:hover {
    transform: translateX(6px);
    border-color: transparent;
    background: #fff;
    color: #0b1440;
  }
  .cta__ico {
    display: grid;
    flex: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: linear-gradient(135deg, #3d78ff, #2a3cff);
    color: #fff;
  }
  .cta__ico svg {
    width: 22px;
    height: 22px;
  }
  .cta__label {
    display: grid;
    flex: 1;
    gap: 0.1rem;
  }
  .cta__label small {
    font-size: 0.8rem;
    opacity: 0.7;
  }
  .cta__label strong {
    font-size: 1.1rem;
    font-weight: 700;
  }
  .cta__go {
    width: 20px;
    height: 20px;
    transition: transform 0.4s var(--ease-out);
  }
  .cta__list a:hover .cta__go {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .cta__panel {
      grid-template-columns: 1fr;
    }
  }

  .footer {
    background: #f4f4f6;
    padding-block: 3.5rem 2.5rem;
    font-size: var(--fs-sm);
    color: #6b6b74;
  }
  .footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 2rem;
    border-bottom: 1px solid #e0e0e5;
  }
  .footer__logo {
    width: auto;
    height: 64px;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    padding-top: 2rem;
  }
  address {
    display: grid;
    gap: 0.5rem;
    font-style: normal;
  }
  address span {
    white-space: nowrap;
  }
  address i {
    margin-inline: 0.6rem;
    font-style: normal;
  }
  .footer__tel {
    display: grid;
    justify-items: end;
    gap: 0.25rem;
  }
  .footer__tel strong {
    color: #141416;
    font-size: 2rem;
    letter-spacing: -0.02em;
  }
  .footer__copy {
    margin-top: 3rem;
    font-size: 0.8rem;
  }

  @media (max-width: 700px) {
    .footer__tel {
      justify-items: start;
    }
  }
</style>
