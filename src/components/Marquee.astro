---
interface Props {
  items: string[];
  /** 한 바퀴 도는 시간(초) */
  duration?: number;
}

const { items, duration = 30 } = Astro.props;
---

<div class="marquee" style={`--duration: ${duration}s`}>
  <div class="marquee__track">
    {
      [0, 1].map((copy) => (
        <ul class="marquee__list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee var(--duration) linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__list {
    display: flex;
    gap: 4rem;
    padding: 0 2rem;
    list-style: none;
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--c-muted);
    white-space: nowrap;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
