---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import Marquee from '@/components/Marquee.astro';
import CTA from '@/components/CTA.astro';
import { withBase } from '@/lib/url';

const features = [
  { title: '기능 하나', body: '핵심 가치를 한두 문장으로 설명하는 자리입니다.' },
  { title: '기능 둘', body: '사용자가 얻는 구체적인 이점을 적어주세요.' },
  { title: '기능 셋', body: '차별점이나 신뢰를 주는 요소를 소개합니다.' },
];

const stats = [
  { value: 1200, suffix: '+', label: '누적 사용자' },
  { value: 98, suffix: '%', label: '만족도' },
  { value: 4.9, decimals: 1, label: '평균 평점' },
];

const partners = ['Partner A', 'Partner B', 'Partner C', 'Partner D', 'Partner E', 'Partner F'];
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__bg" data-parallax="0.4" aria-hidden="true">
      <span class="hero__blob hero__blob--a"></span>
      <span class="hero__blob hero__blob--b"></span>
    </div>

    <div class="container hero__inner">
      <span class="eyebrow" data-reveal data-delay="0.05">Landing boilerplate</span>
      <h1 class="hero__title" data-split>안녕하세요</h1>
      <p class="hero__lead muted" data-reveal data-delay="0.4">
        서브 카피가 들어갈 자리입니다. 서비스가 무엇이고 누구를 위한 것인지 짧게 설명하세요.
      </p>
      <div class="hero__actions" data-reveal data-delay="0.55">
        <Button href="#features">자세히 보기</Button>
        <Button href={withBase('/about')} variant="ghost">About</Button>
      </div>
    </div>

    <div class="hero__scroll" aria-hidden="true"><span></span></div>
  </section>

  <!-- Partners -->
  <section class="partners" data-reveal="fade">
    <Marquee items={partners} />
  </section>

  <!-- Features -->
  <section class="section" id="features">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow" data-reveal>Features</span>
        <h2 data-split data-split-scroll>섹션 제목을 입력하세요</h2>
      </header>

      <div class="grid" data-stagger="0.12">
        {features.map((f, i) => <FeatureCard index={i + 1} {...f} />)}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section stats">
    <div class="container stats__grid" data-stagger>
      {
        stats.map((s) => (
          <div class="stat">
            <strong
              class="stat__value"
              data-count={s.value}
              data-suffix={s.suffix}
              data-decimals={s.decimals}
            >
              {s.value}
              {s.suffix}
            </strong>
            <span class="muted">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <CTA title="마지막 행동 유도 문구를 적어주세요" href="mailto:hello@example.com" label="문의하기" />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-top: var(--header-h);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: -10% 0;
    pointer-events: none;
  }

  .hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.45;
    animation: float 14s ease-in-out infinite alternate;
  }

  .hero__blob--a {
    width: 40vw;
    height: 40vw;
    top: 10%;
    right: -5%;
    background: var(--c-accent);
  }

  .hero__blob--b {
    width: 30vw;
    height: 30vw;
    bottom: 5%;
    left: -5%;
    background: #ff7ab6;
    animation-delay: -7s;
  }

  @keyframes float {
    to {
      transform: translate3d(-6vw, 4vw, 0) scale(1.15);
    }
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }

  .hero__title {
    max-width: 14ch;
    font-size: var(--fs-display);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .hero__lead {
    max-width: 52ch;
    font-size: var(--fs-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    width: 1px;
    height: 56px;
    background: var(--c-border);
    overflow: hidden;
  }

  .hero__scroll span {
    position: absolute;
    inset: 0;
    background: var(--c-text);
    animation: scroll-hint 2s var(--ease-out) infinite;
  }

  @keyframes scroll-hint {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }

  /* ---------- Partners ---------- */
  .partners {
    padding-block: 2.5rem;
    border-block: 1px solid var(--c-border);
  }

  /* ---------- Features ---------- */
  .section-head {
    display: grid;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .section-head h2 {
    max-width: 18ch;
    font-size: var(--fs-xl);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.25rem;
  }

  /* ---------- Stats ---------- */
  .stats {
    padding-top: 0;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 2rem;
  }

  .stat {
    display: grid;
    gap: 0.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-border);
  }

  .stat__value {
    font-size: var(--fs-xl);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
  }
</style>
