---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTA from '@/components/CTA.astro';
import { withBase } from '@/lib/url';

const values = [
  { title: '가치 하나', body: '팀이 중요하게 생각하는 원칙을 설명하세요.' },
  { title: '가치 둘', body: '일하는 방식이나 철학을 소개하세요.' },
  { title: '가치 셋', body: '고객에게 약속하는 것을 적어주세요.' },
];

const timeline = [
  { year: '2024', text: '프로젝트 시작' },
  { year: '2025', text: '첫 번째 마일스톤' },
  { year: '2026', text: '정식 출시' },
];
---

<BaseLayout title="About" description="About 페이지 설명을 입력하세요.">
  <!-- Page header -->
  <section class="page-head">
    <div class="container">
      <span class="eyebrow" data-reveal>About us</span>
      <h1 class="page-head__title" data-split>우리를 소개하는 문장을 적어주세요</h1>
    </div>
  </section>

  <!-- Story: 이미지 + 텍스트 -->
  <section class="section story">
    <div class="container story__grid">
      <div class="story__media" data-reveal="scale">
        <!-- 이미지로 교체: <img src={withBase('/images/about.jpg')} alt="" /> -->
        <div class="story__placeholder" data-parallax="0.25"></div>
      </div>
      <div class="story__text">
        <h2 data-split data-split-scroll>스토리 섹션 제목</h2>
        <p class="muted" data-reveal data-delay="0.1">
          회사/서비스의 배경과 문제 의식, 그리고 해결하고자 하는 방향을 서술하는 영역입니다. 두세 문단
          정도가 적당합니다.
        </p>
        <p class="muted" data-reveal data-delay="0.2">
          두 번째 문단입니다. 구체적인 사례나 수치를 넣으면 신뢰도가 높아집니다.
        </p>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section values">
    <div class="container">
      <h2 class="values__heading" data-reveal>Values</h2>
      <ol class="values__list" data-stagger="0.1">
        {
          values.map((v, i) => (
            <li class="value">
              <span class="value__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{v.title}</h3>
              <p class="muted">{v.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section timeline">
    <div class="container">
      <h2 class="values__heading" data-reveal>History</h2>
      <ul class="timeline__list">
        {
          timeline.map((t, i) => (
            <li class="timeline__item" data-reveal="left" data-delay={i * 0.1}>
              <strong>{t.year}</strong>
              <span>{t.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTA title="함께할 준비가 되셨나요?" href={withBase('/')} label="홈으로" />
</BaseLayout>

<style>
  .page-head {
    padding-top: calc(var(--header-h) + var(--space-section) * 0.8);
    padding-bottom: calc(var(--space-section) * 0.5);
  }

  .page-head__title {
    max-width: 16ch;
    margin-top: 1rem;
    font-size: var(--fs-display);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  /* ---------- Story ---------- */
  .story__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .story__media {
    aspect-ratio: 4 / 5;
    border-radius: calc(var(--radius) * 1.5);
    overflow: hidden;
  }

  .story__placeholder {
    width: 100%;
    height: 130%;
    margin-top: -15%;
    background:
      radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--c-accent) 60%, transparent), transparent 60%),
      radial-gradient(circle at 70% 80%, #ff7ab6, transparent 55%),
      var(--c-surface);
  }

  .story__text {
    display: grid;
    gap: 1.25rem;
  }

  .story__text h2 {
    font-size: var(--fs-xl);
  }

  @media (max-width: 768px) {
    .story__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Values ---------- */
  .values__heading {
    margin-bottom: 2.5rem;
    font-size: var(--fs-xl);
  }

  .values__list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--c-border);
  }

  .value {
    display: grid;
    grid-template-columns: 4rem 1fr 1.5fr;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 2rem;
    border-bottom: 1px solid var(--c-border);
    transition: padding-left 0.5s var(--ease-out);
  }

  .value:hover {
    padding-left: 1rem;
  }

  .value__num {
    color: var(--c-accent);
    font-variant-numeric: tabular-nums;
  }

  .value h3 {
    font-size: var(--fs-lg);
  }

  @media (max-width: 768px) {
    .value {
      grid-template-columns: 3rem 1fr;
    }
    .value p {
      grid-column: 2;
    }
  }

  /* ---------- Timeline ---------- */
  .timeline {
    padding-top: 0;
  }

  .timeline__list {
    list-style: none;
    padding: 0 0 0 1.5rem;
    border-left: 1px solid var(--c-border);
    display: grid;
    gap: 2rem;
  }

  .timeline__item {
    position: relative;
    display: grid;
    gap: 0.25rem;
  }

  .timeline__item::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 5px);
    top: 0.55em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c-accent);
  }

  .timeline__item strong {
    font-size: var(--fs-lg);
  }
</style>
